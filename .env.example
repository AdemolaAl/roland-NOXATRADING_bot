BOT_TOKEN=
ALERT_CHANNEL_ID=
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/noxatrading_dev
SESSION_ENCRYPTION_KEY=
# Comma-separated extra admins. Leave blank if not needed.
ADMIN_TELEGRAM_IDS=
# One or more comma-separated super-admin IDs.
SUPER_ADMIN_TELEGRAM_ID=
IQ_TEST_EMAIL=
IQ_TEST_PASSWORD=
IQ_SDK_HTTP_URL=
IQ_SDK_WS_URL=
IQ_SDK_PLATFORM_ID=82
# Fractional values allowed. 0.5 = aggressive 30-min nudge cadence.
INACTIVITY_PING_HOURS=0.5
PRO_DAILY_CHART_LIMIT=5
LOG_LEVEL=info
NODE_ENV=development
# Affstore S2S postback secret. Generate with `openssl rand -hex 32`.
# Set in Affstore as the ?secret= query param on the postback URL.
AFFSTORE_POSTBACK_SECRET=
