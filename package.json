{
  "name": "noxatrading-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:pretty": "tsx watch --env-file-if-exists=.env src/index.ts | pino-pretty --colorize --ignore pid,hostname",
    "iq:discover": "tsx scripts/discover-iq-options.ts",
    "iq:discover:all": "tsx scripts/discover-iq-options.ts --all",
    "seed:media": "tsx --env-file-if-exists=.env scripts/seedMediaFileIds.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "release": "npm run db:migrate && npm start",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:migrate:create": "node-pg-migrate create -m migrations -j sql",
    "db:test:setup": "node scripts/setup-test-db.mjs && DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/noxatrading_test} node-pg-migrate up -m migrations -j sql",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=tests/integration",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tradecodehub/client-sdk-js": "^1.3.0",
    "dayjs": "^1.11.20",
    "node-pg-migrate": "^8.0.4",
    "opossum": "^9.0.0",
    "p-retry": "^8.0.0",
    "pg": "^8.20.0",
    "pg-boss": "^12.18.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "telegraf": "^4.16.3",
    "undici": "^8.5.0",
    "xstate": "^5.31.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
